<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>OfficeConnect</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>office_mobile</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<!-- Hardware and Privacy Permissions for Enterprise ESS -->
	<key>NSCameraUsageDescription</key>
	<string>OfficeConnect requires camera access to capture employee selfie attendance and scan expense receipts.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>OfficeConnect uses your location to verify office geofence proximity for clock-in and client visits.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>OfficeConnect uses your location to verify office geofence proximity during working hours.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>OfficeConnect uses Face ID to securely authenticate and protect employee personal data.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>OfficeConnect requires photo library access to upload invoice receipts and medical certificates.</string>

	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
